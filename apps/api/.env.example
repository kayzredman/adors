# ============================================================
# ADORS API — Environment Variables
# Copy this to .env and fill in your values
# NEVER commit .env to git
# ============================================================

# ---- Server ------------------------------------------------
NODE_ENV=development
PORT=4000

# ---- GitHub Models API (Claude / GPT-4o) -------------------
GITHUB_TOKEN=your_github_pat_here
GITHUB_MODELS_BASE_URL=https://models.inference.ai.azure.com
DEFAULT_AGENT_MODEL=claude-3-7-sonnet

# ---- Supabase (self-hosted) --------------------------------
SUPABASE_URL=http://localhost:8000
SUPABASE_SERVICE_KEY=your_supabase_service_role_key
SUPABASE_JWT_SECRET=your_jwt_secret

# ---- Redis -------------------------------------------------
REDIS_URL=redis://localhost:6379

# ---- Oracle UAT --------------------------------------------
ORACLE_UAT_USER=adors_monitor
ORACLE_UAT_PASSWORD=
ORACLE_UAT_CONNECTSTRING=ora-uat-01.internal:1521/ORCL

# ---- Oracle PROD -------------------------------------------
ORACLE_PROD_USER=adors_monitor
ORACLE_PROD_PASSWORD=
ORACLE_PROD_CONNECTSTRING=ora-prod-01.internal:1521/ORCL

# ---- MSSQL UAT ---------------------------------------------
MSSQL_UAT_HOST=sql-uat-01.internal
MSSQL_UAT_PORT=1433
MSSQL_UAT_USER=adors_monitor
MSSQL_UAT_PASSWORD=
MSSQL_UAT_DATABASE=master

# ---- MSSQL PROD --------------------------------------------
MSSQL_PROD_HOST=sql-prod-01.internal
MSSQL_PROD_PORT=1433
MSSQL_PROD_USER=adors_monitor
MSSQL_PROD_PASSWORD=
MSSQL_PROD_DATABASE=master

# ---- MariaDB UAT -------------------------------------------
MARIADB_UAT_HOST=maria-uat-01.internal
MARIADB_UAT_PORT=3306
MARIADB_UAT_USER=adors_monitor
MARIADB_UAT_PASSWORD=
MARIADB_UAT_DATABASE=information_schema

# ---- MariaDB PROD ------------------------------------------
MARIADB_PROD_HOST=maria-prod-01.internal
MARIADB_PROD_PORT=3306
MARIADB_PROD_USER=adors_monitor
MARIADB_PROD_PASSWORD=
MARIADB_PROD_DATABASE=information_schema

# ---- Baileys (WhatsApp) ------------------------------------
WHATSAPP_ENABLED=false
WHATSAPP_ALERT_NUMBER=+1234567890

# ---- Teams -------------------------------------------------
TEAMS_ENABLED=false
TEAMS_WEBHOOK_URL=

# ---- Health Scanner ----------------------------------------
HEALTH_SCAN_INTERVAL_MS=300000
ALERT_COOLDOWN_MS=900000
