{
  "name": "adors",
  "version": "0.1.0",
  "private": true,
  "description": "Agentic Database Observability & Remediation System",
  "scripts": {
    "dev": "turbo dev",
    "dev:apps": "turbo dev --filter='./apps/*'",
    "build": "turbo build",
    "lint": "turbo lint",
    "type-check": "turbo type-check",
    "start": "pnpm infra:up && pnpm dev",
    "stop": "pnpm infra:down && cmd //c \"taskkill /F /IM node.exe\" 2>nul || true",
    "db:migrate": "pnpm --filter @adors/db migrate",
    "db:seed": "pnpm --filter @adors/db seed",
    "db:setup": "pnpm db:migrate && pnpm db:seed",
    "infra:up": "docker compose -f infra/compose/docker-compose.dev.yml --env-file infra/compose/.env up -d",
    "infra:down": "docker compose -f infra/compose/docker-compose.dev.yml down",
    "infra:logs": "docker compose -f infra/compose/docker-compose.dev.yml logs -f",
    "test": "pnpm --recursive test"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.0",
  "devDependencies": {
    "turbo": "^2.9.6"
  }
}
