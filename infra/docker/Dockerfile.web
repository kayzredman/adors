FROM node:22-alpine AS base
WORKDIR /app
RUN npm install -g pnpm@9

FROM base AS development
COPY package.json pnpm-workspace.yaml ./
COPY apps/web/package.json ./apps/web/
COPY packages/shared/package.json ./packages/shared/
RUN pnpm install
COPY apps/web ./apps/web
COPY packages/shared ./packages/shared
WORKDIR /app/apps/web
EXPOSE 3000
CMD ["pnpm", "dev"]

FROM base AS builder
COPY package.json pnpm-workspace.yaml ./
COPY apps/web/package.json ./apps/web/
COPY packages/shared/package.json ./packages/shared/
RUN pnpm install --frozen-lockfile
COPY apps/web ./apps/web
COPY packages/shared ./packages/shared
RUN pnpm --filter @adors/shared build
RUN pnpm --filter @adors/web build

FROM node:22-alpine AS production
WORKDIR /app
RUN apk add --no-cache tini && \
    addgroup -g 1001 -S adors && \
    adduser -S adors -u 1001 -G adors
ENV NODE_ENV=production
COPY --from=builder --chown=adors:adors /app/apps/web/.next/standalone ./
COPY --from=builder --chown=adors:adors /app/apps/web/.next/static ./apps/web/.next/static
COPY --from=builder --chown=adors:adors /app/apps/web/public ./apps/web/public
USER adors
EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
  CMD wget -qO- http://localhost:3000/ || exit 1
ENTRYPOINT ["tini", "--"]
CMD ["node", "apps/web/server.js"]
