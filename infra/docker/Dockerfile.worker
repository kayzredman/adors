FROM node:22-alpine AS base
WORKDIR /app
RUN npm install -g pnpm@9

FROM base AS development
COPY package.json pnpm-workspace.yaml ./
COPY apps/api/package.json ./apps/api/
COPY packages/agents/package.json ./packages/agents/
COPY packages/db/package.json ./packages/db/
COPY packages/shared/package.json ./packages/shared/
RUN pnpm install
COPY apps/api ./apps/api
COPY packages ./packages
WORKDIR /app/apps/api
CMD ["pnpm", "tsx", "src/workers/index.ts"]

FROM base AS builder
COPY package.json pnpm-workspace.yaml ./
COPY apps/api/package.json ./apps/api/
COPY packages/agents/package.json ./packages/agents/
COPY packages/db/package.json ./packages/db/
COPY packages/shared/package.json ./packages/shared/
RUN pnpm install --frozen-lockfile
COPY apps/api ./apps/api
COPY packages ./packages
RUN pnpm --filter @adors/shared build
RUN pnpm --filter @adors/agents build
RUN pnpm --filter @adors/api build

FROM node:22-alpine AS production
WORKDIR /app
RUN apk add --no-cache tini && \
    addgroup -g 1001 -S adors && \
    adduser -S adors -u 1001 -G adors
RUN npm install -g pnpm@9
COPY --from=builder --chown=adors:adors /app/apps/api/dist ./dist
COPY --from=builder --chown=adors:adors /app/node_modules ./node_modules
ENV NODE_ENV=production
USER adors
HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
  CMD node -e "process.exit(0)" || exit 1
ENTRYPOINT ["tini", "--"]
CMD ["node", "dist/workers/index.js"]
