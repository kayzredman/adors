############################################################
# ADORS Dev Stack — Environment Variables
#
# USAGE:
#   cp infra/compose/.env.example infra/compose/.env
#   # Edit .env with your secrets
#   docker compose -f infra/compose/docker-compose.dev.yml up -d
#
# The JWT keys below are the official Supabase local-dev defaults.
# They pair with JWT_SECRET below. DO NOT use in production.
############################################################

# ── Database ─────────────────────────────────────────────────────────────────
# Password for the Postgres superuser AND all Supabase internal roles
POSTGRES_PASSWORD=supersecret

# ── JWT ──────────────────────────────────────────────────────────────────────
# Must be ≥ 32 characters. Used by GoTrue (auth) and PostgREST.
# Change this before going to production — then regenerate ANON_KEY + SERVICE_ROLE_KEY.
JWT_SECRET=your-super-secret-jwt-token-with-at-least-32-characters-long

# ── API Keys (JWTs pre-signed for the JWT_SECRET above) ──────────────────────
# Client-side key — safe to expose in browser code
ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyAgCiAgICAicm9sZSI6ICJhbm9uIiwKICAgICJpc3MiOiAic3VwYWJhc2UtZGVtbyIsCiAgICAiaWF0IjogMTY0MTc2OTIwMCwKICAgICJleHAiOiAxNzk5NTM1NjAwCn0.dc_X5iR_VP_qT0zsiyj_I_OZ2T9FtRU2BBNWN8Bu4GE

# Server-side key — NEVER expose to browsers
SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyAgCiAgICAicm9sZSI6ICJzZXJ2aWNlX3JvbGUiLAogICAgImlzcyI6ICJzdXBhYmFzZS1kZW1vIiwKICAgICJpYXQiOiAxNjQxNzY5MjAwLAogICAgImV4cCI6IDE3OTk1MzU2MDAKfQ.DaYlNEoUrrEn2Ig7tqibS-PHK5vgusbcbo7X36XVt4Q

# ── URLs ──────────────────────────────────────────────────────────────────────
# External URL Kong is reachable at (used by GoTrue for redirect links in emails)
API_EXTERNAL_URL=http://localhost:8000
SITE_URL=http://localhost:3000
